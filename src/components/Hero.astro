---
import Foto from './Foto.astro';
import BotonConsulta from './BotonConsulta.astro';
import type { Foto as F } from '../data/fotos';
interface Props { foto: F; titulo: string; bajada: string; }
const { foto, titulo, bajada } = Astro.props;
---
<section class="hero hero--place" aria-labelledby="hero-h">
  <Foto foto={foto} class="hero__bg" sizes="100vw" eager />
  <div class="wrap"><div class="hero-text">
    <div class="hero__text">
      <h1 id="hero-h">{titulo}</h1>
      <p class="hero__lead">{bajada}</p>
      <div class="btn-row"><BotonConsulta /></div>
    </div>
  </div></div>
</section>
