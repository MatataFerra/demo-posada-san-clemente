---
import Foto from './Foto.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import type { Foto as F } from '../data/fotos';
interface Props { foto: F; titulo: string; bajada: string; mensaje?: string; }
const { foto, titulo, bajada, mensaje } = Astro.props;
---
<section class="hero hero--place" aria-labelledby="hero-h">
  <Foto foto={foto} class="hero__bg" sizes="100vw" eager />
  <div class="wrap"><div class="hero-text">
    <div class="hero__text">
      <h1 id="hero-h">{titulo}</h1>
      <p class="hero__lead">{bajada}</p>
      <div class="btn-row"><BotonWhatsApp mensaje={mensaje} /></div>
    </div>
  </div></div>
</section>
