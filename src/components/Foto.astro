---
import { srcset, type Foto } from '../data/fotos';
interface Props { foto: Foto; sizes?: string; eager?: boolean; class?: string; }
const { foto, sizes = '(max-width: 1023px) 100vw, 50vw', eager = false, class: cls } = Astro.props;
const { src, srcset: set } = srcset(foto);
---
<img
  class={cls}
  src={src}
  srcset={set}
  sizes={sizes}
  width={foto.ancho}
  height={foto.alto}
  alt={foto.alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  data-source={foto.origen}
  data-subject={foto.tema}
  style={foto.pos ? `object-position: ${foto.pos}` : undefined}
/>
