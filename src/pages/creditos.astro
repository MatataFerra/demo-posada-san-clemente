---
import Base from '../layouts/Base.astro';
import { FOTOS } from '../data/fotos';
---
<Base
  titulo="Créditos de fotografías | Posada La Ría"
  descripcion="Autores y licencias de las fotografías usadas en el sitio de Posada La Ría."
  ogImagen="/og/inicio.jpg"
>
  <section class="section" id="creditos" aria-labelledby="cred-h" style="--h: 1">
    <div class="wrap">
      <div class="grid grid--top">
        <div class="span-4 stack-4">
          <h1 id="cred-h" class="t-h2">Créditos de fotografías</h1>
          <p>Todas las fotos tienen licencia libre y vienen de Wikimedia Commons.</p>
        </div>
        <ul class="rows span-8 start-5">
          {Object.values(FOTOS).map((f) => (
            <li><span class="rows__name"><a class="link" href={f.pagina} target="_blank" rel="noopener">{f.autor}</a></span><span class="rows__value"><a href={f.licenciaUrl} target="_blank" rel="noopener">{f.licencia}</a></span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
